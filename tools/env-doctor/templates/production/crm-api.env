# env-doctor template — crm-api (production). See infra/README.md § Variable reference.
# (value taxonomy documented in ./auth.env)
# specs/20261101-crm, 018 (estimates, offers, attachments), 019 (notifications), 020 (offer
# documents). crm-api is a JWKS + authorization-enforcing resource server (ADR 20260716-refund-api-authorization-enforcing-resource-server lineage,
# ADR 20261101-crm-tool-shape-and-authorization). Its secrets: the database password (DATABASE_URL), the bucket credentials (set
# by reference to the Railway bucket by infra/provision-tool.sh) and its service-client
# secret (a Railway Shared Variable).

DATABASE_URL=postgresql://${{Postgres.PGUSER}}:${{Postgres.PGPASSWORD}}@${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/crm

# Shell origin only. crm-ui is a federated remote, so the browser Origin on every call is
# the shell's (ADR 20260709-suite-frontend-module-federation).
ALLOWED_ORIGINS=https://operai.welld.io

AUTH_ISSUER=https://auth.operai.welld.io
AUTH_JWKS_URL=http://${{auth.RAILWAY_PRIVATE_DOMAIN}}:${{auth.PORT}}/auth/jwks
# Internal CALLS on auth: GET /authz/resolve (ADR 20260716-refund-api-authorization-enforcing-resource-server) and POST /authz/users/identities
# (ADR 20260807-live-identity-resolution-by-id-fail-soft). Private DNS, distinct from AUTH_ISSUER.
AUTH_BASE_URL=http://${{auth.RAILWAY_PRIVATE_DOMAIN}}:${{auth.PORT}}
AUTH_AUDIENCE=${{shared.AUTH_AUDIENCE}}

# specs/20261101-crm-sales-flow: estimates are created in EstimAI with the caller's own JWT, over private networking.
ESTIMAI_API_URL=http://${{estimai-api.RAILWAY_PRIVATE_DOMAIN}}:${{estimai-api.PORT}}

# specs/20261101-crm-sales-flow: offers, attachments and letterheads in the CRM's own EU bucket (ADR 20260716-eu-object-storage-refund-attachments lineage).
# CRM_S3_BUCKET / _ENDPOINT / _ACCESS_KEY_ID / _SECRET_ACCESS_KEY are set by reference to the
# Railway bucket `crm` by infra/provision-tool.sh --bucket.
CRM_S3_REGION=ams
CRM_S3_EU_ENDPOINT_HOSTS=t3.storageapi.dev

# specs/20261101-crm-notifications: CRM notifications through notify-api (ADR 20261013-all-notify-callers-scoped-credentials-shared-token-retired/0056). The id is a key of auth's
# SERVICE_CLIENTS (scope "notifications.push emails.send deal-link-notices.send activities.write
# projects.purchase-orders.read" since specs/20261103-projects-handoff and specs/20261110-activities); the secret equals that entry's. One
# service client for every call: env.ts requires the pair with NOTIFY_INTERNAL_URL, PROJECTS_INTERNAL_URL,
# ESTIMAI_INTERNAL_URL or ACTIVITIES_API_URL, and never alone.
NOTIFY_INTERNAL_URL=${{shared.NOTIFY_INTERNAL_URL}}
SERVICE_CLIENT_ID=crm-api
SERVICE_CLIENT_SECRET=${{shared.CRM_SERVICE_CLIENT_SECRET}}

# specs/20261108-estimate-list-oversight (ADR 20261108-crm-pushes-deal-links-to-estimai): where crm-api tells EstimAI that a deal linked or unlinked an estimate
# (the "Deal" badge), over private networking. Unset, the badge never changes.
ESTIMAI_INTERNAL_URL=http://${{estimai-api.RAILWAY_PRIVATE_DOMAIN}}:${{estimai-api.PORT}}

# specs/20261110-activities (ADR 20261110-activities-service-access-delegated-to-host/0082): where crm-api reaches activities-api, over private networking: its user
# routes as the caller, /system/v1/* as itself (scope "activities.write" on the SERVICE_CLIENT_ID
# credential above, subject system:crm-api).
ACTIVITIES_API_URL=http://${{activities-api.RAILWAY_PRIVATE_DOMAIN}}:${{activities-api.PORT}}

# specs/20261103-projects-handoff: the deal page reads its project and Bexio order id from projects-api's
# `GET /system/purchase-orders` as itself (scope projects.purchase-orders.read, ADR 20261104-projects-handoff-live-reads-between-crm-and-projects-over-service-credentials), same service client.
# Required here — without it the deal page says the delivery side is unavailable.
PROJECTS_INTERNAL_URL=http://${{projects-api.RAILWAY_PRIVATE_DOMAIN}}:${{projects-api.PORT}}

# The audience of the scoped service JWTs crm-api verifies on its /system routes: estimai-api's
# estimate notices (specs/20261101-crm-sales-flow AC-3.3, ADR 20261105-estimai-closes-the-estimate-crm-follows), meetings-api's host notices to
# POST /system/meeting-host/v1/notices (specs/20261104-meetings, ADR 20261104-meeting-host-contract-resolve-and-notices; sub "system:meetings-api", scope
# "host-notices.send") and projects-api's reads of GET /system/companies (specs/20261103-projects,
# ADR 20261103-projects-api-reads-crm-companies-with-scoped-service-credential; scope "crm.companies.read"). Verified via AUTH_JWKS_URL; byte-identical to auth's and
# notify-api's, and DIFFERENT from AUTH_AUDIENCE, so a service token is useless on every user
# route. Without it every /system/* request is a 401.
SERVICE_AUDIENCE=${{shared.SERVICE_AUDIENCE}}

PORT=8084
NODE_ENV=production
