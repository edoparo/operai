# env-doctor template — auth (production).
# The exact env you set on the Railway `auth` service. Source of truth for the
# per-service tables in infra/README.md § Variable reference.
#
# Value taxonomy (see tools/env-doctor/README.md):
#   literal            → public identity / browser-facing URL — the doctor CHECKS it
#   ${{railway.ref}}   → Railway reference (internal DNS, or a project Shared Variable)
#   ${OP:vault/item/f} → a 1Password secret; `--resolve` expands it via `op read`
#                        (deliberately NOT literal `op://…` so committed files stay
#                         clear of the secret scanner's 1password-reference rule)

DATABASE_URL=postgresql://${{Postgres.PGUSER}}:${{Postgres.PGPASSWORD}}@${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/auth
BETTER_AUTH_SECRET=${OP:Employee/Paperclip - BETTER_AUTH_SECRET/password}

# Public identity — the JWT `iss`; must equal every resource server's AUTH_ISSUER.
BETTER_AUTH_URL=https://auth.operai.welld.io

# Suite-wide constant / shared secret — define ONCE as a Railway project Shared Variable.
AUTH_AUDIENCE=${{shared.AUTH_AUDIENCE}}

# Scoped service JWTs (specs/20261006-hardware-inventory, ADR 20261006-scoped-service-jwt-fourth-notify-caller; the only notify-api credential since specs/20261013-notify-service-credentials,
# ADR 20261013-all-notify-callers-scoped-credentials-shared-token-retired — the old shared token is forbidden on every service). SERVICE_AUDIENCE is the `aud` stamped on them:
# it MUST differ from AUTH_AUDIENCE and equal notify-api's. SERVICE_CLIENTS is a JSON object
# keyed by client id; each secret is a Railway Shared Variable (set on the project, no
# 1Password item yet) referenced INSIDE the JSON, and must equal the caller's own
# SERVICE_CLIENT_SECRET. Check the resolved value in the Variables tab after saving.
# specs/20261103-projects: the `projects-api` client holds `crm.companies.read` (crm-api's /system/companies, ADR 20261103-projects-api-reads-crm-companies-with-scoped-service-credential);
# specs/20261103-projects-handoff adds `crm.deals.read` (crm-api's /system/deals, ADR 20261104-projects-handoff-live-reads-between-crm-and-projects-over-service-credentials), `crm.contacts.read` (crm-api's
# /system/contacts, the PO referent; held by this client only), `estimai.estimates.read`
# (estimai-api's /system/estimates/{id}/summary, ADR 20261104-estimai-api-first-system-route-estimate-man-days-for-a-service-credential) and
# `notifications.push` (the push to a PO's ops-manager after a take). The `crm-api` client gains
# `projects.purchase-orders.read` (projects-api's /system/purchase-orders, ADR 20261104-projects-handoff-live-reads-between-crm-and-projects-over-service-credentials) besides its notify scopes.
# specs/20261110-activities: the `activities-api` client holds exactly `notifications.push emails.send` (task notices, ADR 20261101-notify-api-resolves-email-notice-address-from-auth);
# `crm-api` gains `activities.write` (activities-api's /system/v1/*, ADR 20261110-caller-chosen-ids-replace-cross-service-transactions). Deploy auth BEFORE crm-api asks.
SERVICE_AUDIENCE=${{shared.SERVICE_AUDIENCE}}
SERVICE_CLIENTS={"inventory-api":{"secret":"${{shared.INVENTORY_SERVICE_CLIENT_SECRET}}","scope":"notifications.push"},"estimai-api":{"secret":"${{shared.ESTIMAI_SERVICE_CLIENT_SECRET}}","scope":"notifications.push estimate-notices.send"},"refund-api":{"secret":"${{shared.REFUND_SERVICE_CLIENT_SECRET}}","scope":"notifications.push emails.send"},"crm-api":{"secret":"${{shared.CRM_SERVICE_CLIENT_SECRET}}","scope":"notifications.push emails.send deal-link-notices.send activities.write projects.purchase-orders.read"},"notify-api":{"secret":"${{shared.NOTIFY_SERVICE_CLIENT_SECRET}}","scope":"users.contact"},"meetings-api":{"secret":"${{shared.MEETINGS_SERVICE_CLIENT_SECRET}}","scope":"notifications.push host-notices.send"},"projects-api":{"secret":"${{shared.PROJECTS_SERVICE_CLIENT_SECRET}}","scope":"crm.companies.read crm.deals.read crm.contacts.read estimai.estimates.read notifications.push"},"activities-api":{"secret":"${{shared.ACTIVITIES_SERVICE_CLIENT_SECRET}}","scope":"notifications.push emails.send"}}

# Public / browser-facing.
ALLOWED_ORIGINS=https://operai.welld.io
UI_HOME_URL=https://operai.welld.io/

# Internal CALL to notify-api over Railway private networking (http, private DNS, target's PORT).
NOTIFY_INTERNAL_URL=http://${{notify-api.RAILWAY_PRIVATE_DOMAIN}}:${{notify-api.PORT}}

# OAuth + RS256 keypair — 1Password (resolved with --resolve).
GOOGLE_CLIENT_ID=${OP:AIScream/OperAI - GOOGLE OAuth/Client ID}
GOOGLE_CLIENT_SECRET=${OP:AIScream/OperAI - GOOGLE OAuth/Client Secret}
GITHUB_CLIENT_ID=${OP:AIScream/OperAI - GITHUB OAuth/Client ID}
GITHUB_CLIENT_SECRET=${OP:AIScream/OperAI - GITHUB OAuth/Client Secret}
JWT_PRIVATE_KEY=${OP:AIScream/OperAI Private Key/private key}
JWT_PUBLIC_KEY=${OP:AIScream/OperAI Private Key/public key}

# Operator-set: the first admin (specs/20260713-auth-roles-permissions AC-6.1). Not secret; edit to the real account.
BOOTSTRAP_ADMIN_EMAIL=matteo.codogno@welld.ch

# Sign-up gate (specs/20261105-signup-gate, ADR 20261105-access-only-by-invitation-waiting-list): only these domains may join the waiting list or be
# invited. Comma-separated, lower-case, at least one. Missing or malformed → auth exits.
ALLOWED_SIGNUP_DOMAINS=welld.ch,welld.it

# Set explicitly so private-networking callers can reference ${{auth.PORT}}.
PORT=3001
NODE_ENV=production
