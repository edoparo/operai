# env-doctor template — hours-api (production). See infra/README.md § Time tracking.
# (value taxonomy documented in ./auth.env)
# specs/029-time-tracking. hours-api holds time entries, categories and work types (ADR-0088). It is
# a JWKS resource server that asks each owner "may this person book on ..." (projects-api, crm-api,
# activities-api, meetings-api) with the caller's own JWT and fails closed on a write (ADR-0089).
# The one call it makes as ITSELF is meetings-api's GET /system/meetings/hosts (a meeting's current
# deal). Its only secrets are the database password (DATABASE_URL) and its service-client secret
# (a Railway Shared Variable). It stores no file and sends no notification. Every variable below is
# required by its own src/lib/env.ts: the service exits at start without one.

DATABASE_URL=postgresql://${{Postgres.PGUSER}}:${{Postgres.PGPASSWORD}}@${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/hours

# Shell origin + admin-ui's OWN origin. hours-ui is a federated remote, so the browser Origin on its
# calls is the shell's (ADR-0006); admin-ui's Time lists page calls the lists routes directly, as its
# rates screen calls refund-api (ADR-0023).
ALLOWED_ORIGINS=https://operai.welld.io,https://admin.operai.welld.io

AUTH_ISSUER=https://auth.operai.welld.io
AUTH_JWKS_URL=http://${{auth.RAILWAY_PRIVATE_DOMAIN}}:${{auth.PORT}}/auth/jwks
# Internal CALLS on auth: GET /authz/resolve (the two live permissions), POST /authz/users/identities
# (ADR-0039) and POST /system/service-token (ADR-0044). Private DNS, distinct from AUTH_ISSUER.
AUTH_BASE_URL=http://${{auth.RAILWAY_PRIVATE_DOMAIN}}:${{auth.PORT}}
AUTH_AUDIENCE=${{shared.AUTH_AUDIENCE}}

# The owners (ADR-0089), over private networking on each target's own PORT. Called with the caller's
# forwarded JWT, 2 s, failing closed on a write; meetings-api's /system/meetings/hosts gets hours-api's
# own service JWT instead. Unset, the service does not start.
PROJECTS_API_URL=http://${{projects-api.RAILWAY_PRIVATE_DOMAIN}}:${{projects-api.PORT}}
CRM_API_URL=http://${{crm-api.RAILWAY_PRIVATE_DOMAIN}}:${{crm-api.PORT}}
ACTIVITIES_API_URL=http://${{activities-api.RAILWAY_PRIVATE_DOMAIN}}:${{activities-api.PORT}}
MEETINGS_API_URL=http://${{meetings-api.RAILWAY_PRIVATE_DOMAIN}}:${{meetings-api.PORT}}

# Scoped service JWT (ADR-0044/0049). The id is a key of auth's SERVICE_CLIENTS with EXACTLY the scope
# "meetings.hosts.read"; the secret equals that entry's. A Railway Shared Variable, never committed.
# Add the entry to auth ONLY after the auth that knows the scope is live (an unknown scope stops
# auth, ADR-0076).
SERVICE_CLIENT_ID=hours-api
SERVICE_CLIENT_SECRET=${{shared.HOURS_SERVICE_CLIENT_SECRET}}

# The `aud` of that service JWT: byte-identical to auth's and meetings-api's (which verifies it on
# GET /system/meetings/hosts), and DIFFERENT from AUTH_AUDIENCE.
SERVICE_AUDIENCE=${{shared.SERVICE_AUDIENCE}}

PORT=8088
NODE_ENV=production
