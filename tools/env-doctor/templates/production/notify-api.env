# env-doctor template — notify-api (production). See infra/README.md § Variable reference.
# (value taxonomy documented in ./auth.env)
#
# NOTE: PORT is 8080 here even though the code default (src/lib/env.ts) is 8081 —
# Railway's public domain for this service targets 8080, so PORT=8080 is what it
# actually binds, and what ${{notify-api.PORT}} must resolve to for auth's and
# refund-api's NOTIFY_INTERNAL_URL to reach it. Confirm against the dashboard.

# Web push (specs/20261111-push-notifications, ADR 20261111-web-push-encrypted-payloads-not-fcm). Enabled in production on 2026-11-13 (ADR 20261111-web-push-encrypted-payloads-not-fcm go-live sign-off).
# The pair lives in 1Password `AIScream/OperAI - Web Push VAPID` (private-key, public-key, subject);
# the public key is not secret. The email-notice group below is required while enabled (the
# activity check resolves the recipient through auth). Rotating the pair invalidates every
# subscription (infra/README.md § Push notifications).
PUSH_ENABLED=true
VAPID_PUBLIC_KEY=BH3aSaFRyLHZXRaW1vVZ5V52Meo5Wtat2MG-6MgbdLTsmO1L07Rt4t3kVZ3x9Qrgq0d_U97aI0DpSOjqFwH_MW0
VAPID_PRIVATE_KEY=${OP:AIScream/OperAI - Web Push VAPID/private-key}
VAPID_SUBJECT=mailto:operai@welld.io
# PUSH_EXCLUDED_ORIGINS=

DATABASE_URL=postgresql://${{Postgres.PGUSER}}:${{Postgres.PGPASSWORD}}@${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/notify
ALLOWED_ORIGINS=https://operai.welld.io

AUTH_ISSUER=https://auth.operai.welld.io
AUTH_JWKS_URL=http://${{auth.RAILWAY_PRIVATE_DOMAIN}}:${{auth.PORT}}/auth/jwks
AUTH_AUDIENCE=${{shared.AUTH_AUDIENCE}}

# Scoped service JWT audience (ADR 20261006-scoped-service-jwt-fourth-notify-caller, required since specs/20261013-notify-service-credentials/ADR 20261013-all-notify-callers-scoped-credentials-shared-token-retired): byte-identical to auth's
# SERVICE_AUDIENCE and DIFFERENT from AUTH_AUDIENCE. It is the only credential notify-api accepts on
# /system/*; the service exits at startup without it.
SERVICE_AUDIENCE=${{shared.SERVICE_AUDIENCE}}

MAX_STREAM_DURATION=1800

# Email notices addressed by user id (specs/20261101-crm-notifications, ADR 20261101-notify-api-resolves-email-notice-address-from-auth): notify-api looks the address up in
# auth (POST /system/users/contact) with its own service credential (scope users.contact, a key
# of auth's SERVICE_CLIENTS) and links the email to APP_BASE_URL. All four or none.
APP_BASE_URL=https://operai.welld.io
AUTH_BASE_URL=http://${{auth.RAILWAY_PRIVATE_DOMAIN}}:${{auth.PORT}}
SERVICE_CLIENT_ID=notify-api
SERVICE_CLIENT_SECRET=${{shared.NOTIFY_SERVICE_CLIENT_SECRET}}

# Email channel (specs/20260713-user-invitations, ADR 20260714-notify-api-email-channel-service-trust). Keep EMAIL_ENABLED=false until the Resend
# sending domain is verified (infra/README.md § Resend domain setup); when you
# flip it to true, add the two secrets below:
EMAIL_ENABLED=true
# RESEND_API_KEY=${OP:AIScream/OperAI - Resend API Key/credential}
# RESEND_FROM=no-reply@operai.welld.io

PORT=8080
NODE_ENV=production
