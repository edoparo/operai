# env-doctor template — projects-api (production). See infra/README.md § Variable reference.
# (value taxonomy documented in ./auth.env)
# specs/20261103-projects. projects-api is a JWKS + authorization-enforcing resource server
# (ADR 20260716-refund-api-authorization-enforcing-resource-server): live /authz/resolve, fail closed. Its only secrets are the database password
# (DATABASE_URL) and its service-client secret (a Railway Shared Variable).

DATABASE_URL=postgresql://${{Postgres.PGUSER}}:${{Postgres.PGPASSWORD}}@${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/projects

# Shell origin only. projects-ui is a federated remote, so the browser Origin on every call is
# the shell's (ADR 20260709-suite-frontend-module-federation).
ALLOWED_ORIGINS=https://operai.welld.io

AUTH_ISSUER=https://auth.operai.welld.io
AUTH_JWKS_URL=http://${{auth.RAILWAY_PRIVATE_DOMAIN}}:${{auth.PORT}}/auth/jwks
# Internal CALLS on auth: GET /authz/resolve (ADR 20260716-refund-api-authorization-enforcing-resource-server), POST /authz/users/identities (ADR 20260807-live-identity-resolution-by-id-fail-soft),
# POST /authz/app-access-check (ADR 20261101-app-access-check-by-user-id-and-directory-app-filter) and POST /system/service-token (ADR 20261006-scoped-service-jwt-fourth-notify-caller). Private DNS,
# distinct from AUTH_ISSUER.
AUTH_BASE_URL=http://${{auth.RAILWAY_PRIVATE_DOMAIN}}:${{auth.PORT}}
AUTH_AUDIENCE=${{shared.AUTH_AUDIENCE}}

# CRM company names and won deals, read as itself (ADR 20261103-projects-api-reads-crm-companies-with-scoped-service-credential, ADR 20261104-projects-handoff-live-reads-between-crm-and-projects-over-service-credentials): the id is a key of auth's
# SERVICE_CLIENTS (scope "crm.companies.read crm.deals.read crm.contacts.read estimai.estimates.read
# notifications.push"), the secret equals that entry's. All three or none in the service's own
# env.ts; required here — without them a company name is null and the company picker answers 503.
CRM_INTERNAL_URL=http://${{crm-api.RAILWAY_PRIVATE_DOMAIN}}:${{crm-api.PORT}}
SERVICE_CLIENT_ID=projects-api
SERVICE_CLIENT_SECRET=${{shared.PROJECTS_SERVICE_CLIENT_SECRET}}

# A deal's estimate man-days, read from estimai-api as itself (ADR 20261104-estimai-api-first-system-route-estimate-man-days-for-a-service-credential, scope
# "estimai.estimates.read"). Goes with CRM_INTERNAL_URL: the service-token provider is built only
# when that is set. Required here — without it taking a deal that has an estimate answers 503
# `estimai_unconfigured`.
ESTIMAI_INTERNAL_URL=http://${{estimai-api.RAILWAY_PRIVATE_DOMAIN}}:${{estimai-api.PORT}}

# The push to a PO's ops-manager after a take, through notify-api as itself (scope
# "notifications.push", specs/20261103-projects-handoff T25). Private networking, notify-api's PORT. Optional in the
# service's own env.ts (the push is a no-op without it); required here — without it the ops-manager
# is never notified of a take.
NOTIFY_INTERNAL_URL=http://${{notify-api.RAILWAY_PRIVATE_DOMAIN}}:${{notify-api.PORT}}

# The `aud` of the scoped service JWTs auth mints, accepted on GET /system/purchase-orders (ADR 20261104-projects-handoff-live-reads-between-crm-and-projects-over-service-credentials):
# byte-identical to auth's, crm-api's, estimai-api's and notify-api's, different from AUTH_AUDIENCE.
SERVICE_AUDIENCE=${{shared.SERVICE_AUDIENCE}}

PORT=8086
NODE_ENV=production
