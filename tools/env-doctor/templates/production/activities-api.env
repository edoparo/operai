# env-doctor template — activities-api (production). See infra/README.md § Variable reference.
# (value taxonomy documented in ./auth.env)
# specs/20261110-activities. activities-api holds the activities, tasks and blockers of the CRM and
# the projects module (ADR 20261110-activities-service-access-delegated-to-host). It is a JWKS resource server that owns NO permission catalog:
# every read and write asks the record's host ("may this user ...") with the caller's own JWT and
# fails closed. Its only secrets are the database password (DATABASE_URL) and its service-client
# secret (a Railway Shared Variable).

DATABASE_URL=postgresql://${{Postgres.PGUSER}}:${{Postgres.PGPASSWORD}}@${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/activities

# Shell origin only. The CRM and projects remotes run inside the shell, so the browser Origin on
# every call is the shell's (ADR 20260709-suite-frontend-module-federation); there is no activities-ui.
ALLOWED_ORIGINS=https://operai.welld.io

AUTH_ISSUER=https://auth.operai.welld.io
AUTH_JWKS_URL=http://${{auth.RAILWAY_PRIVATE_DOMAIN}}:${{auth.PORT}}/auth/jwks
# Private DNS, distinct from AUTH_ISSUER.
AUTH_BASE_URL=http://${{auth.RAILWAY_PRIVATE_DOMAIN}}:${{auth.PORT}}
AUTH_AUDIENCE=${{shared.AUTH_AUDIENCE}}

# The hosts (ADR 20261110-activities-service-access-delegated-to-host): POST /activity-host/v1/resolve, called with the caller's forwarded JWT,
# over private networking. Unset, every read is a 503 host_unavailable.
CRM_API_URL=http://${{crm-api.RAILWAY_PRIVATE_DOMAIN}}:${{crm-api.PORT}}
PROJECTS_API_URL=http://${{projects-api.RAILWAY_PRIVATE_DOMAIN}}:${{projects-api.PORT}}

# Task notifications through notify-api (ADR 20261013-all-notify-callers-scoped-credentials-shared-token-retired/0056), as itself. The id is a key of auth's
# SERVICE_CLIENTS (scope "notifications.push emails.send": the email notices of AC-6.1/6.3 need
# the second); the secret equals that entry's.
NOTIFY_INTERNAL_URL=${{shared.NOTIFY_INTERNAL_URL}}
SERVICE_CLIENT_ID=activities-api
SERVICE_CLIENT_SECRET=${{shared.ACTIVITIES_SERVICE_CLIENT_SECRET}}

# The audience of the scoped service JWTs activities-api verifies on /system/v1/* (crm-api, scope
# "activities.write", sub "system:crm-api", ADR 20261110-caller-chosen-ids-replace-cross-service-transactions). Verified via AUTH_JWKS_URL; byte-identical
# to auth's, notify-api's and crm-api's, and DIFFERENT from AUTH_AUDIENCE.
SERVICE_AUDIENCE=${{shared.SERVICE_AUDIENCE}}

# ADR 20261113-task-description-files-in-activities-api-bucket: task images and attachments in activities-api's OWN EU bucket (never another tool's).
# ACTIVITIES_S3_BUCKET / _ENDPOINT / _ACCESS_KEY_ID / _SECRET_ACCESS_KEY are set by reference to the
# Railway bucket `activities` (declared in .railway/railway.ts). Unset, the file routes answer 503.
ACTIVITIES_S3_REGION=ams
ACTIVITIES_S3_EU_ENDPOINT_HOSTS=t3.storageapi.dev

# Runbook switch (ADR 20261110-activities-migration-write-pause): true makes every route except GET /health answer 503 `maintenance`
# during the CRM -> activities-api copy. Steady state is false.
ACTIVITIES_MAINTENANCE=false

PORT=8087
NODE_ENV=production
