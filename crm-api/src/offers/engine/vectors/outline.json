{
  "template": [
    "@@salutation S",
    "",
    "Opening [OPENF] [CLIENTE] [DEALF]",
    "",
    "## OGGETTO",
    "[A] {{?B::[B]}} {{blk::[IN_BLK]}} [LIST1] [TAB] [M] {{?M::[M]}}",
    "{{!NEVER::none}}",
    "@@OPT_START blk2",
    "[IN_BLK2] {{x::inner [DEEP]}}",
    "@@OPT_END",
    "{{opta::[IN_A]}}{{optb::[IN_B]}}",
    "",
    "## CONDIZIONI",
    "@@step conditions",
    "[C1] [OVR] [DER]",
    "",
    "## COSTI",
    "@@step costs",
    "@@costs position",
    "@@line a one_off | [COSTFIELD] | unit=[PRICE] | qty=1",
    "@@OPT_START voce",
    "@@line v one_off each=TAB | V | unit=? | qty=1",
    "@@OPT_END",
    "@@total **TOTALE**",
    "@@total Totale __secondo__",
    "@@end",
    "[LATE]",
    "",
    "@@OPT_START annexblk",
    "@@annex SLA Servizio",
    "## PARTE",
    "[IN_ANNEX]",
    "@@OPT_END",
    "",
    "@@field OPENF",
    "label: Apertura",
    "",
    "@@field CLIENTE",
    "source: client",
    "",
    "@@field DEALF",
    "label: Affare",
    "source: deal",
    "",
    "@@field A",
    "label: Campo A",
    "hint: Un aiuto",
    "example: es. A",
    "default: ciao",
    "",
    "@@field B",
    "label: Campo B",
    "",
    "@@field M",
    "label: Misto",
    "",
    "@@field IN_BLK",
    "label: Nel blocco",
    "",
    "@@field IN_BLK2",
    "label: Nel blocco due",
    "",
    "@@field DEEP",
    "label: Profondo",
    "",
    "@@field NEVER",
    "label: Mai",
    "",
    "@@field IN_A",
    "label: In A",
    "",
    "@@field IN_B",
    "label: In B",
    "",
    "@@field C1",
    "label: Uno",
    "kind: number",
    "",
    "@@field OVR",
    "label: Spostato",
    "step: annexes",
    "",
    "@@field DER",
    "label: Derivato",
    "kind: number",
    "compute: C1 + 1",
    "",
    "@@field COSTFIELD",
    "label: Voce di costo",
    "",
    "@@field PRICE",
    "label: Prezzo",
    "kind: amount",
    "",
    "@@field LATE",
    "label: Tardi",
    "options: x | y",
    "fills y: C1 = 5",
    "",
    "@@field IN_ANNEX",
    "label: Nell'allegato",
    "",
    "@@field COL",
    "label: Colonna",
    "kind: number",
    "",
    "@@field UNUSED",
    "label: Mai usato",
    "",
    "@@list LIST1",
    "label: Elenco",
    "hint: Uno per riga",
    "",
    "@@table TAB",
    "label: Tabella",
    "columns: TAB, COL",
    "",
    "@@block blk",
    "label: Blocco",
    "explain: Spiega",
    "default: on",
    "fills: C1 = 3",
    "",
    "@@block blk2",
    "label: Blocco due",
    "",
    "@@block x",
    "label: Interno",
    "",
    "@@block voce",
    "label: Voce",
    "",
    "@@block annexblk",
    "label: Allegato",
    "",
    "@@block opta",
    "label: Opzione A",
    "fills: IN_B = a",
    "",
    "@@block optb",
    "label: Opzione B",
    "",
    "@@choice scelta",
    "label: Scelta",
    "options: opta | optb",
    "default: optb"
  ],
  "editor": {
    "scope": {
      "sections": ["OGGETTO"],
      "items": [
        "field:OPENF", "field:DEALF", "field:A", "field:B", "block:blk(field:IN_BLK)", "list:LIST1", "table:TAB", "field:M",
        "field:NEVER", "block:blk2(field:IN_BLK2,block:x(field:DEEP))", "choice:scelta", "field:IN_A", "field:IN_B"
      ]
    },
    "conditions": { "sections": ["CONDIZIONI"], "items": ["field:C1", "field:DER"] },
    "costs": { "sections": ["COSTI"], "items": ["costs(a,v|TOTALE,Totale secondo)", "field:COSTFIELD", "field:PRICE", "block:voce", "field:LATE"] },
    "annexes": { "sections": ["PARTE@SLA"], "items": ["field:OVR", "block:annexblk(field:IN_ANNEX)"] }
  },
  "wizard": [
    {
      "name": "defaults: blk on, optb chosen, everything else off",
      "blocks": {},
      "scope": ["field:OPENF", "field:DEALF", "field:A", "field:B", "block:blk(field:IN_BLK)", "list:LIST1", "table:TAB", "field:M", "field:NEVER", "block:blk2", "choice:scelta", "field:IN_B"],
      "conditions": ["field:C1", "field:DER"],
      "costs": ["costs(a|TOTALE,Totale secondo)", "field:COSTFIELD", "field:PRICE", "block:voce", "field:LATE"],
      "annexes": ["field:OVR", "block:annexblk"],
      "annexSections": []
    },
    {
      "name": "blk off hides its field; blk2 on shows its field and the inner switch; opta chosen shows IN_A",
      "blocks": { "blk": false, "blk2": true, "opta": true, "optb": false },
      "scope": ["field:OPENF", "field:DEALF", "field:A", "field:B", "block:blk", "list:LIST1", "table:TAB", "field:M", "field:NEVER", "block:blk2(field:IN_BLK2,block:x)", "choice:scelta", "field:IN_A"],
      "conditions": ["field:C1", "field:DER"],
      "costs": ["costs(a|TOTALE,Totale secondo)", "field:COSTFIELD", "field:PRICE", "block:voce", "field:LATE"],
      "annexes": ["field:OVR", "block:annexblk"],
      "annexSections": []
    },
    {
      "name": "every block on: lines of the cost block, the deep field and the annex appear",
      "blocks": { "blk": true, "blk2": true, "x": true, "voce": true, "annexblk": true, "opta": false, "optb": true },
      "scope": ["field:OPENF", "field:DEALF", "field:A", "field:B", "block:blk(field:IN_BLK)", "list:LIST1", "table:TAB", "field:M", "field:NEVER", "block:blk2(field:IN_BLK2,block:x(field:DEEP))", "choice:scelta", "field:IN_B"],
      "conditions": ["field:C1", "field:DER"],
      "costs": ["costs(a,v|TOTALE,Totale secondo)", "field:COSTFIELD", "field:PRICE", "block:voce", "field:LATE"],
      "annexes": ["field:OVR", "block:annexblk(field:IN_ANNEX)"],
      "annexSections": ["PARTE@SLA"]
    }
  ]
}
