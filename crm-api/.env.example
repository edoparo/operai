# crm-api — local development. Copy to .env (gitignored). No secrets here: .envrc exports
# DATABASE_URL from the root POSTGRES_* values. Validated at startup by src/lib/env.ts.

# Origins allowed by CORS: the shell (crm-ui is a federated remote mounted by it)
ALLOWED_ORIGINS=http://localhost:5173

# auth service — JWKS verification (ADR 20260703-jwt-resource-server-remote-jwks/0010), /authz/resolve, /authz/users/identities
AUTH_JWKS_URL=http://localhost:3001/auth/jwks
AUTH_ISSUER=http://localhost:3001
AUTH_AUDIENCE=operai-suite
AUTH_BASE_URL=http://localhost:3001

SERVICE_AUDIENCE=operai-service

PORT=8084
NODE_ENV=development

ESTIMAI_API_URL=http://localhost:8080
CRM_S3_ENDPOINT=http://localhost:9000
CRM_S3_REGION=auto
CRM_S3_BUCKET=operai-crm-files-dev
CRM_S3_ACCESS_KEY_ID=minioadmin
CRM_S3_SECRET_ACCESS_KEY=minioadmin
CRM_S3_EU_ENDPOINT_HOSTS=s3.railway-eu-amsterdam.example.com,localhost
NOTIFY_INTERNAL_URL=http://localhost:8081
ESTIMAI_INTERNAL_URL=http://localhost:8080
ACTIVITIES_API_URL=http://localhost:8087
# activities-api (specs/20261110-activities): where activities and tasks live; called as system:crm-api (scope activities.write)
ACTIVITIES_API_URL=http://localhost:8087
SERVICE_CLIENT_ID=crm-api
SERVICE_CLIENT_SECRET=<segreto crm>

# Audience of the service credentials /system/* accepts (ADR 20261006-scoped-service-jwt-fourth-notify-caller); equal to auth's SERVICE_AUDIENCE
SERVICE_AUDIENCE=operai-service

# specs/20261103-projects-handoff (ADR 20261104-projects-handoff-live-reads-between-crm-and-projects-over-service-credentials): projects-api base URL, for the deal page's delivery card; uses SERVICE_CLIENT_* above
PROJECTS_INTERNAL_URL=http://localhost:8086
