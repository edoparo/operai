   { "name": "with the reference: twice for two tokens", "reference": "0007/2026r1", "body": "⟪REF⟫ e ⟪REF⟫", "expect": "0007/2026r1 e 0007/2026r1" },
   { "name": "with the reference: in a section whose template never used it", "reference": "0007/2026", "section": "ALTRA", "body": "Vedi ⟪REF⟫", "expect": "Vedi 0007/2026" },
   { "name": "the reference is escaped like an answer", "reference": "a|b_c", "body": "| ⟪REF⟫ | x |", "expect": "| a\\|b\\_c | x |" },
   { "name": "a backslash before the token does not escape it", "reference": "0007/2026", "body": "\\⟪REF⟫", "expect": "\\0007/2026" },
   { "name": "tokens mode keeps the token as written", "mode": "tokens", "reference": "0007/2026", "body": "Rif. ⟪REF⟫ fine", "expect": "Rif. ⟪REF⟫ fine" },
   { "name": "any other bracket is not a token: it prints as a question mark", "reference": "0007/2026", "body": "a ⟪ b ⟫ c ⟪ref⟫ ⟪⟪REF⟫⟫", "expect": "a ? b ? c ?ref? ?0007/2026?" }
  ]
 },
 "bounds": {
  "_doc": "The resolved text is bounded while it is built (QE D1, M-1): a section, an annex section, the opening and an annex intro each print at most 20 000 characters, else the unit is invalid `section_too_long` (name `section:<key>`, `opening`, `annex:<designation>`) and its text stops short of 21 000. `fill` is { FIELD: [text, times] }; `lengths` the printed body length by heading; `atMost` bounds every printed body, opening and intro; a case may carry its own `template` (lines) instead of the group's. A unit over the limit is ALWAYS reported, even when its first line alone passes the bound and nothing of it prints (QE D6).",
  "template": [
   "@@salutation S",
   "@@acceptance C",
   "",
   "[O]",
   "",
   "## UNO",
   "@@step scope",
   "[D]",
   "",
   "## TRE",
   "@@step scope",
   "[T] [T] [T]",
   "",
   "## COSTI",
   "@@step costs",
   "@@costs",
   "@@line a one_off | A | unit=100 | qty=1",
   "@@total **T**",
   "@@end",
   "",
   "@@annex A Annesso",
   "[I]",
   "",
   "## PARTE",
   "[P] [P]",
   "",
   "@@field D",
   "label: Dd",
   "",
   "@@field T",
   "label: Tt",
   "",
   "@@field O",
   "label: Oo",
   "",
   "@@field I",
   "label: Ii",
   "",
   "@@field P",
   "label: Pp"
  ],
  "cases": [
   { "name": "a section of exactly 20 000 characters prints", "fill": { "D": ["x", 20000] }, "expect": { "invalid": [], "lengths": { "UNO": 20000 } } },
   { "name": "one character more is section_too_long at the section, and the text stays bounded", "fill": { "D": ["x", 20001] }, "expect": { "invalid": [["section:UNO#0", "UNO", "scope", "section_too_long"]], "atMost": 21000 } },
   { "name": "a field used three times counts every use: 3 x 6 666 and two spaces is exactly 20 000", "fill": { "T": ["y", 6666] }, "expect": { "invalid": [], "lengths": { "TRE": 20000 } } },
   { "name": "three uses of 6 667 characters are over the limit", "fill": { "T": ["y", 6667] }, "expect": { "invalid": [["section:TRE#0", "TRE", "scope", "section_too_long"]], "atMost": 21000 } },
   { "name": "an answer of 20 000 characters used three times stops after the first use", "fill": { "T": ["z", 20000] }, "expect": { "invalid": [["section:TRE#0", "TRE", "scope", "section_too_long"]], "atMost": 21000 } },
   { "name": "an answer that escapes to more than it holds is counted as printed: 10 001 stars print as 20 002", "fill": { "D": ["*", 10001] }, "expect": { "invalid": [["section:UNO#0", "UNO", "scope", "section_too_long"]], "atMost": 21000 } },
   { "name": "the opening of exactly 20 000 characters prints", "fill": { "O": ["o", 20000] }, "expect": { "invalid": [], "lengths": { "": 20000 } } },
   { "name": "the opening one character over is invalid at `opening`", "fill": { "O": ["o", 20001] }, "expect": { "invalid": [["opening", null, "scope", "section_too_long"]], "atMost": 21000 } },
   { "name": "an annex intro one character over is invalid at the annex", "fill": { "I": ["i", 20001] }, "expect": { "invalid": [["annex:A", null, "annexes", "section_too_long"]], "atMost": 21000 } },
   { "name": "an annex section is bounded like a section: two uses of 10 001 characters", "fill": { "P": ["p", 10001] }, "expect": { "invalid": [["section:PARTE#0", "PARTE", "annexes", "section_too_long"]], "atMost": 21000 } },
   { "name": "a section whose FIRST line alone passes the build bound is invalid, never dropped (QE D6): 10 600 stars print as 21 200", "fill": { "D": ["*", 10600] }, "expect": { "invalid": [["section:UNO#0", "UNO", "scope", "section_too_long"]], "lengths": { "UNO": 0 }, "atMost": 21000 } },
   { "name": "an annex section whose first line alone passes the build bound is invalid, never dropped (QE D6)", "fill": { "P": ["*", 10600] }, "expect": { "invalid": [["section:PARTE#0", "PARTE", "annexes", "section_too_long"]], "lengths": { "PARTE": 0 }, "atMost": 21000 } },
   { "name": "an opening whose first line alone passes the build bound is invalid (QE D6)", "fill": { "O": ["*", 10600] }, "expect": { "invalid": [["opening", null, "scope", "section_too_long"]], "atMost": 21000 } },
   { "name": "an annex made only of an intro whose first line alone passes the build bound is invalid, not dropped silently (QE D6)", "template": ["@@salutation S", "@@acceptance C", "", "## UNO", "@@step scope", "x", "", "@@annex A Annesso", "[I]", "", "@@field I", "label: Ii"], "fill": { "I": ["*", 10600] }, "expect": { "invalid": [["annex:A", null, "annexes", "section_too_long"]], "atMost": 21000 } },
   { "name": "a heading that passes the build bound keeps its section and is reported (QE D6)", "template": ["@@salutation S", "@@acceptance C", "", "## [D][D][D]", "@@step scope", "x", "", "@@field D", "label: Dd"], "fill": { "D": ["h", 10000] }, "expect": { "invalid": [["section:[D][D][D]#0", "[D][D][D]", "scope", "section_too_long"]], "atMost": 21000 } },
   { "name": "every unit over the limit is reported once, in the order the document prints", "fill": { "O": ["o", 20001], "D": ["x", 20001], "T": ["y", 20000], "I": ["i", 20001], "P": ["p", 20000] }, "expect": { "invalid": [["opening", null, "scope", "section_too_long"], ["section:UNO#0", "UNO", "scope", "section_too_long"], ["section:TRE#0", "TRE", "scope", "section_too_long"], ["annex:A", null, "annexes", "section_too_long"], ["section:PARTE#0", "PARTE", "annexes", "section_too_long"]], "atMost": 21000 } }
  ]
 }
}
