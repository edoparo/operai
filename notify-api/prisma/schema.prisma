generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Models ───────────────────────────────────────────────────────────────────

// Notification (T2, specs/005-notification-center, plan.md §Data model).
//
// recipientId = JWT `sub` (ADR-0005). v1: always == the caller's sub. NOT a
// foreign key — notify-api is a resource server with no user table (users
// live only in the auth DB); ownership is enforced by the sub predicate, like
// estimai-api's Estimate.userId.
//
// severity/originApp are String (not Prisma enums) to match the codebase
// convention — the closed set is validated at the zod boundary, keeping DB
// migrations off the critical path when the set grows.
//
// No "was-unread" column — that affordance is a client viewing-session concept
// (notify-ui captures the unread set at open), not durable state.
// No retention/expiry field (spec non-goal: no retention policy).
model Notification {
  id          String    @id @default(cuid())
  recipientId String
  title       String
  body        String
  // Optional Italian variant (specs/021-meetings, ADR-0065). Both set or both
  // null (the zod boundary requires the pair); the READER picks it from
  // <html lang>, English title/body stay the fallback.
  titleIt     String?
  bodyIt      String?
  severity    String // "info" | "success" | "warning" | "error" (zod-enum at the boundary)
  originApp   String // "estimai" | "refund" | "admin" | … (zod-enum at the boundary)
  linkHref    String?
  linkLabel   String?
  toastWorthy Boolean   @default(false)
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([recipientId, createdAt(sort: Desc)]) // list newest-first (AC-2.3)
  @@index([recipientId, readAt]) // unread-count / mark-all-read (AC-1.2, AC-3.1)
  @@map("notification")
}

// EmailDelivery (T1, specs/006-user-invitations, plan.md §Data model, ADR-0011).
//
// A delivery-log row for notify-api's SECOND channel (email, alongside the
// existing in-app/SSE channel above). Addresses a RAW email string — there is
// no `User` table in this service (users live only in the auth DB), so this
// is deliberately NOT a foreign key, mirroring recipientId on Notification.
//
// One row per send ATTEMPT (create + resend both write a new row — no update-
// in-place), so the log is an audit trail of attempts, not current state.
// `status` is the outcome of the synchronous send ("queued" is reserved for a
// future async delivery path — v1 never leaves a row in that state).
// `providerId` is Resend's message id (present only when status == "sent").
// `error` is a short failure reason (present only when status == "failed") —
// never the raw Resend/network error object (ADR-0011 Risks: never log the
// internal token or email content; this column follows the same posture).
model EmailDelivery {
  id         String   @id @default(cuid())
  to         String
  template   String // "invitation" | "invitation_resend" (closed set validated at the zod boundary)
  status     String // "queued" | "sent" | "failed"
  providerId String? // Resend message id, present only when status == "sent"
  error      String? // short failure reason, present only when status == "failed"
  createdAt  DateTime @default(now())

  @@index([to, createdAt(sort: Desc)]) // per-address delivery history, newest-first
  @@map("email_delivery")
}

// PushDevice (T3, specs/029-push-notifications, plan.md §Data model, ADR-0084).
//
// One browser push subscription of one user. `userId` = JWT `sub`, NOT a foreign
// key (no user table in this service, like Notification.recipientId). `endpoint`
// is unique across ALL users: a browser re-subscribed by another account moves
// the row to the new owner (AC-5.3) instead of keeping two owners for one browser.
// `endpoint`, `p256dh` and `auth` are secrets of the subscription: never logged
// and never returned by the API. Rows are deleted, never soft-deleted; no
// delivery log (spec non-goal).
model PushDevice {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  label     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("push_device")
}
