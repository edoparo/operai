# hours-api — local environment (specs/029-time-tracking, ADR-0088/0089).
# Copy to .env or, as the other services do, put these in the direnv file (.envrc) next to it.
# Never commit the filled-in copy.

# ─── Database ─────────────────────────────────────────────────────────────────
# Shared local Postgres (compose.yaml, host port 5435), logical database `hours`.
# The test suite uses `hours_test` (src/test-support/env.ts derives it from this URL).
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/hours

# ─── HTTP ─────────────────────────────────────────────────────────────────────
# The browser calls hours-api from the SHELL's origin (hours-ui runs inside it) and from
# admin-ui's (the Time lists page, inside the shell too), so :5173 is required; add :5184
# (hours-ui) / :5177 (admin-ui) only to run a remote standalone.
ALLOWED_ORIGINS=http://localhost:5173
PORT=8088
NODE_ENV=development

# ─── Identity (JWKS resource server, ADR-0005/0010) ───────────────────────────
# Same values as crm-api / projects-api / activities-api.
AUTH_JWKS_URL=http://localhost:3001/auth/jwks
AUTH_ISSUER=http://localhost:3001
AUTH_AUDIENCE=<same as crm-api AUTH_AUDIENCE>
AUTH_BASE_URL=http://localhost:3001

# ─── Owners: who answers "may this person book on ..." (ADR-0089) ─────────────
# Called with the caller's own Authorization header, 2 s, failing closed on a write.
PROJECTS_API_URL=http://localhost:8086
CRM_API_URL=http://localhost:8084
ACTIVITIES_API_URL=http://localhost:8087
MEETINGS_API_URL=http://localhost:8085

# ─── Service credential, as itself (ADR-0044/0049, ADR-0089) ──────────────────
# hours-api reads a meeting's current deal from meetings-api GET /system/meetings/hosts with
# its OWN scoped service JWT (scope `meetings.hosts.read`, sub `system:hours-api`). auth needs
# the matching SERVICE_CLIENTS entry, scope EXACTLY `meetings.hosts.read`:
#   "hours-api":{"secret":"<same secret>","scope":"meetings.hosts.read"}
SERVICE_CLIENT_ID=hours-api
SERVICE_CLIENT_SECRET=<random, at least 32 characters: openssl rand -hex 32>
# Audience of that service JWT: must equal auth's SERVICE_AUDIENCE (and meetings-api's) and
# differ from AUTH_AUDIENCE.
SERVICE_AUDIENCE=<same as auth SERVICE_AUDIENCE>
