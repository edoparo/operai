// Letterhead layout 1 — the one template wellD writes (specs/20261116-letterhead-service).
//
// FROZEN once a letterhead version is saved with it (ADR 20261116-a-letterhead-version-pins-its-layout-and-
// old-layouts-stay-compiled-in): do not edit this file except to fix a defect, with the golden corpus updated
// in the same commit. A change of look is a new layout.
//
// Everything a caller or a person typed arrives as JSON *strings* in /data.json and is placed into the
// document as `str` values: Typst never parses a str as markup, so text is data and never code (US-2). This
// file calls no `eval`, no `plugin` and no `read` of a path a caller chose; the only files it names are
// /data.json and the paths that the engine wrote into that file (/asset/<n>.<ext>, /img/<n>.<ext>).

#let d = json("/data.json")
#let m = d.margins
#let look = d.look
#let fonts = d.fonts
#let lang = d.language

#let hex(h) = rgb("#" + h) // h is validated as six hexadecimal digits before it gets here
#let body-width = 210mm - (m.left + m.right) * 1mm
#let body-height = 297mm - (m.top + m.bottom) * 1mm

// A header or footer is drawn inside its margin, hugging the body: `gap` from the body, and it keeps `edge`
// from the edge of the page. Both are in the engine too (layout::FRAME_GAP_MM, FRAME_EDGE_MM).
#let gap = 3mm
#let edge = 5mm
#let between = 2mm // between the text of a frame and its rule, and between a logo and the text under it

// ─── the page and its text ───────────────────────────────────────────────────

// One line of text is 1em high whatever the font, so that the baseline distance is exactly
// `1.2 * lineSpacing` em (AC-5.9) and does not depend on which font is chosen.
#set text(
  font: fonts.body,
  size: look.body.size * 1pt,
  lang: lang,
  fallback: false,
  hyphenate: false,
  top-edge: 0.8em,
  bottom-edge: -0.2em,
)
#set par(leading: (1.2 * look.body.lineSpacing - 1) * 1em, spacing: 0.9em, justify: false)
#set document(title: none, author: (), keywords: ())

// ─── a word wider than its line is broken at the margin (AC-1.6, amendment A4) ───────────────────

// A word is only ever split when it is wider than the line (or table cell) it is in: Typst moves a word that
// does not fit to the next line, and that is all that happens to any word that fits a line by itself. A word
// that cannot fit even there is cut into pieces that each fit, and the pieces are set as boxes side by side,
// between which a line may break. Nothing is added to the text: no hyphen and no zero-width character, so
// the page's text is what was typed, in the preview and in the PDF alike (AC-1.3, AC-2.1). A break lands
// at the margin because the line is filled up to it.
//
// `avail` is the width of the line the text is in, which the caller knows exactly; `wrap` puts the run's own
// look (bold, a named style, ...) on a piece of text, so that what is measured is what is drawn.
#let widest-glyph = 1.25 // em: no glyph of the bundled fonts is wider
#let largest-text = 24pt // the biggest size any text of a document has (a heading, AC-5.9)

#let break-segment(segment, avail, wrap, width) = {
  let clusters = segment.clusters()
  let em = measure(wrap(text("x"))).height
  // Pieces of an eighth of the line on average, so that a line is filled to within a piece of its margin, and
  // never more than half of it even if every glyph of a piece were the widest one.
  let average = width / clusters.len()
  let count = calc.max(1, calc.min(calc.floor(avail / (8 * average)), calc.floor(avail / (2.5 * em))))
  range(0, clusters.len(), step: count).map(i => box(wrap(text(clusters.slice(i, calc.min(i + count, clusters.len())).join())))).join()
}

// A long word, first at the places where Typst can break it anyway (after a hyphen or a slash), then each
// stretch that is still wider than the line.
#let break-word(word, avail, wrap, limit) = {
  word.matches(regex("[^\\-/]+[\\-/]*|[\\-/]+")).map(m => {
    let segment = m.text
    let width = if segment.clusters().len() <= limit { 0pt } else { measure(wrap(text(segment))).width }
    if width <= avail { wrap(text(segment)) } else { break-segment(segment, avail, wrap, width) }
  }).join()
}

// ─── a stretch that Unicode forbids breaking, however short its words (AC-1.6, amendment A4) ──────────────────

// Typst breaks lines where Unicode (UAX #14) allows, and it forbids a break before a closing bracket, `!`, `?`,
// `,`, `.`, `:`, `;` or `/` even after a space (LB13), after an opening bracket or a quotation mark even
// after a space (LB14, LB15), and some more: a text of such "words" is one stretch that cannot be wrapped, however
// short each word, and when it is wider than its line it would be drawn past the margin. So the text is cut
// into *chains*: words, written as stretches of characters between two spaces, that follow each other
// across a space where a break *might* be forbidden. A boundary is surely free only when a letter or a digit
// is on each side of it, or when a new line is forced. A chain wider than the line has each of its words set as a box
// (a break is allowed before and after a box), so that a line may end at each of its spaces; a word that is
// wider than the line by itself is cut into pieces by `break-word`. A chain that fits the line, and every text
// that has no chain wider than a line, is set as it was typed: nothing is added to the text.
//
// A word is a stretch of characters that holds no space that a line may break at: a no-break space (U+00A0,
// U+2007, U+202F) is a character of the word.
#let token-class = "[\\S\u{a0}\u{2007}\u{202f}]"
#let token-re = regex(token-class + "+")
#let forced-break = regex("[\n\r\u{b}\u{c}\u{85}\u{2028}\u{2029}]")
// The end of a word that a break after the following space might be forbidden by: an opening bracket or a quotation mark.
#let sticks-after = regex("[\\p{Ps}\\p{Pi}\\p{Pf}\"'\u{ab}\u{bb}\u{bf}\u{a1}]$")
// The start of a word that a break before might be forbidden: anything that is not a letter, a digit, an opening
// bracket or an opening quotation mark.
#let sticks-before = regex("^[^\\w\\s\\p{Ps}\\p{Pi}]")
// Whether a text has a place where a chain might be: a space after the end of a word that sticks, or before the
// start of one that sticks. A quick test, so that most texts, which have none, are not taken apart.
#let may-chain = regex("[\\p{Ps}\\p{Pi}\\p{Pf}\"'\u{ab}\u{bb}\u{bf}\u{a1}]\\s|\\s[^\\w\\s\\p{Ps}\\p{Pi}]")

#let chains-of(s) = {
  let out = ()
  let current = ()
  for t in s.matches(token-re) {
    if current.len() > 0 {
      let before = current.last()
      let free = s.slice(before.end, t.start).contains(forced-break) or not (before.text.contains(sticks-after) or t.text.contains(sticks-before))
      if free {
        out.push(current)
        current = ()
      }
    }
    current.push(t)
  }
  if current.len() > 0 { out.push(current) }
  out
}

// A text is a sequence of pieces, each with its own look (a paragraph's runs): `segs` is an array of
// `(text: , wrap: )`. A word, a chain, may run across pieces; it is looked for in all their text at once.
#let safe-runs(segs, avail) = {
  // A text of this many characters or fewer cannot be wider than the line: no measuring for it.
  let limit = calc.max(1, calc.floor(avail / (widest-glyph * largest-text)))
  let segs = segs.filter(g => g.text.len() > 0)
  let plain() = segs.map(g => (g.wrap)(text(g.text))).join()
  let s = segs.map(g => g.text).sum(default: "")
  if s.len() <= limit { return plain() }
  let long-re = regex(token-class + "{" + str(limit + 1) + ",}")
  if not (s.contains(long-re) or s.contains(may-chain)) { return plain() }
  let is-long-text(x) = x.len() > limit and x.contains(long-re)
  let is-long(t) = is-long-text(t.text)
  let chains = chains-of(s)
  let wide(ch) = ch.last().end - ch.first().start > limit
  if not chains.any(ch => wide(ch) and (ch.len() > 1 or is-long(ch.first()))) { return plain() }
  // The pieces of the text between two offsets, each in its look.
  let starts = ()
  let offset = 0
  for g in segs {
    starts.push(offset)
    offset += g.text.len()
  }
  let parts(from, to) = segs.enumerate().map(((i, g)) => {
    let (a, b) = (calc.max(from, starts.at(i)), calc.min(to, starts.at(i) + g.text.len()))
    if a < b { ((text: s.slice(a, b), wrap: g.wrap),) } else { () }
  }).flatten()
  let piece(from, to) = parts(from, to).map(x => (x.wrap)(text(x.text))).join()
  context {
    let out = ()
    let at = 0 // the start of the text that is not set yet
    for ch in chains {
      let (first, last) = (ch.first().start, ch.last().end)
      // A chain wider than the line: each of its words is set as a box, so that a line may end at each space.
      let spread = ch.len() > 1 and wide(ch) and measure(piece(first, last)).width > avail
      for t in ch {
        // A word may run across pieces (a bold start and a plain end): then each piece is cut up if the word
        // as a whole is wider than the line.
        let ps = parts(t.start, t.end)
        let over = ps.len() > 1 and measure(piece(t.start, t.end)).width > avail
        let heavy = spread or over
        if not (heavy or ps.any(x => is-long-text(x.text))) { continue }
        if t.start > at { out.push(piece(at, t.start)) }
        if spread and measure(piece(t.start, t.end)).width <= avail {
          out.push(box(piece(t.start, t.end)))
        } else {
          out.push(ps.map(x => if heavy or is-long-text(x.text) { break-word(x.text, avail, x.wrap, limit) } else { (x.wrap)(text(x.text)) }).join())
        }
        at = t.end
      }
    }
    if at < s.len() { out.push(piece(at, s.len())) }
    out.join()
  }
}

#let safe(content-string, avail, wrap) = safe-runs(((text: content-string, wrap: wrap),), avail)

// ─── header and footer ───────────────────────────────────────────────────────

// The page's variant (AC-5.4, AC-5.5): the first page uses `first`, the last page of a document of more than
// one page uses `last`, every other page `default`.
#let variant-name(p, n) = {
  let v = d.variants
  if p == 1 {
    if v.at("first") != none { "first" } else { "default" }
  } else if p == n and v.at("last") != none { "last" } else { "default" }
}

#let current() = {
  // The fit check lays out one page and asks about the widest page numbers a document can have.
  let (p, n) = if d.fit { (300, 300) } else {
    (counter(page).get().first(), counter(page).final().first())
  }
  let name = variant-name(p, n)
  (p, n, name, d.variants.at(name))
}

// One line of a zone: its parts are text or `{page}` / `{pages}`, in the line's own look (AC-5.2, A2).
#let frame-line(l, p, n, zone-width) = {
  let s = l.parts.map(part => if "t" in part { part.t } else if part.pg == "page" { str(p) } else { str(n) }).join()
  set text(font: fonts.frame, size: l.size * 1pt, fill: hex(l.color), weight: if l.bold { "bold" } else { "regular" })
  set par(leading: 0.3em, spacing: 0.3em)
  par(safe(s, zone-width, c => c))
}

#let logo-here(v, which, k) = {
  which == "header" and v.logo != none and v.logo.position == k
}

#let zone-has(v, which, k) = v.at(which).at(k).len() > 0 or logo-here(v, which, k)

// The three zones of a frame. With no centre zone the left and the right share the width in halves, with one
// in thirds; each zone's lines are aligned to its side (AC-5.2).
#let frame-zones(v, which, p, n) = {
  let f = v.at(which)
  let any = ("left", "center", "right").any(k => zone-has(v, which, k))
  if not any { return none }
  let zones = if zone-has(v, which, "center") {
    (("left", left), ("center", center), ("right", right))
  } else {
    (("left", left), ("right", right))
  }
  // A logo is as high as its height says and as wide as its proportions give; one that would be wider than
  // its zone is scaled down to the zone's width, so that it never reaches into the next zone or the margin.
  let zone-width = (body-width - 4mm * (zones.len() - 1)) / zones.len()
  let logo-image() = {
    let natural = measure(image(v.logo.path, height: v.logo.height * 1mm)).width
    if natural > zone-width { image(v.logo.path, width: zone-width) } else { image(v.logo.path, height: v.logo.height * 1mm) }
  }
  grid(
    columns: zones.map(_ => 1fr),
    column-gutter: 4mm,
    align: if f.valign == "bottom" { bottom } else { top },
    ..zones.map(((k, a)) => {
      let parts = ()
      if logo-here(v, which, k) { parts.push(logo-image()) }
      if f.at(k).len() > 0 { parts.push(stack(dir: ttb, spacing: 2pt, ..f.at(k).map(l => frame-line(l, p, n, zone-width)))) }
      align(a, stack(dir: ttb, spacing: between, ..parts))
    }),
  )
}

// A rule is a filled bar of exactly its thickness, so that the frame's height includes it (AC-5.3).
#let frame-rule(r) = if r.show { rect(width: 100%, height: r.thickness * 1pt, fill: hex(r.color), stroke: none) }

#let frame-content(v, which, p, n) = {
  let zones = frame-zones(v, which, p, n)
  let rule = frame-rule(v.at(which).rule)
  // header: text, then the rule, then the body; footer: the body, then the rule, then the text.
  let parts = if which == "header" { (zones, rule) } else { (rule, zones) }
  stack(dir: ttb, spacing: between, ..parts.filter(x => x != none))
}

// The real height of a frame (lines that wrap, logo, rule) must fit its margin (AC-5.3): never drawn over the
// body, never cut. Panics with a tag that the engine reads.
#let check-fit(content, margin, which, name) = {
  let avail = margin * 1mm - edge - gap
  let h = measure(block(width: body-width, content)).height
  if h > avail { panic("LH_ERR:" + which + "_overflow:" + name) }
}

#let header-block = context {
  let (p, n, name, v) = current()
  if d.only != "footer" {
    let inner = frame-content(v, "header", p, n)
    check-fit(inner, m.top, "header", name)
    block(width: 100%, height: m.top * 1mm, inset: (bottom: gap), align(bottom, inner))
  }
}

#let footer-block = context {
  let (p, n, name, v) = current()
  if d.only != "header" {
    let inner = frame-content(v, "footer", p, n)
    check-fit(inner, m.bottom, "footer", name)
    block(width: 100%, height: m.bottom * 1mm, inset: (top: gap), align(top, inner))
  }
}

#set page(
  paper: "a4",
  margin: (top: m.top * 1mm, bottom: m.bottom * 1mm, left: m.left * 1mm, right: m.right * 1mm),
  header-ascent: 0pt,
  footer-descent: 0pt,
  header: header-block,
  footer: footer-block,
  // Under everything, across the whole page; it never takes room, so it never moves a page break (AC-7.7).
  background: context {
    let (p, n, name, v) = current()
    if v.background != none { image(v.background, width: 100%, height: 100%, fit: "cover") }
  },
)

// ─── named styles (AC-1.7): what each does to each block type ───────────────────────────────────
//
//             heading      paragraph    list         table        image
//   plain     -            -            -            -            -
//   muted     grey text    grey text    grey text    grey text    -
//   small     85 % size    85 % size    85 % size    85 % size    -
//   right     right        right        items right  -            right
//   center    centred      centred      items centre -            centred
//   title     20 pt bold   20 pt bold   20 pt bold   20 pt bold   -
//             heading font heading font heading font heading font
//   missing   highlighted  highlighted  highlighted  highlighted  -
//
// A style with no effect on a block type is accepted and does nothing; it is never an error. The text styles
// are put on every run of the block (a run's own style comes first), so they reach lists and cells too.

#let grey = hex("595c69")

#let text-style(name, c) = {
  if name == "muted" { text(fill: grey, c) }
  else if name == "small" { text(size: 0.85em, c) }
  else if name == "title" { text(font: fonts.heading, size: 20pt, weight: "bold", c) }
  else if name == "missing" { highlight(fill: hex("fff3bf"), top-edge: 0.8em, bottom-edge: -0.2em, text(fill: hex("b35c00"), c)) }
  else { c }
}

#let align-of(name) = if name == "right" { right } else if name == "center" { center } else { left }

// ─── blocks ──────────────────────────────────────────────────────────────────

#show heading: it => {
  let h = look.headings.at(it.level - 1)
  set text(font: fonts.heading, size: h.size * 1pt, weight: if h.bold { "bold" } else { "regular" }, fill: hex(h.color))
  block(above: 1.2em, below: 0.6em, it.body)
}
#set heading(numbering: none, outlined: false, bookmarked: false)
#set block(spacing: 0.9em)

// One run: its own bold, italic, underline and named style, then the block's style.
#let run-wrap(r, block-style) = c => {
  let c = c
  if r.at("bold", default: false) { c = strong(c) }
  if r.at("italic", default: false) { c = emph(c) }
  if r.at("underline", default: false) { c = underline(c) }
  text-style(block-style, text-style(r.at("style", default: none), c))
}

// The runs of a paragraph, a list item or a cell: one text, so that a stretch that cannot be wrapped is found
// across the runs it is made of.
#let runs-content(rs, avail, block-style) = safe-runs(rs.map(r => (text: r.text, wrap: run-wrap(r, block-style))), avail)

#let is-empty(rs) = rs.map(r => r.text.len()).sum(default: 0) == 0

// A paragraph with no text is one empty line: the author's spacing is kept.
#let render-paragraph(b, avail, block-style) = {
  if is-empty(b.runs) { par(box(height: 1em)) } else { par(runs-content(b.runs, avail, block-style)) }
}

// A list is a grid of markers and items, so that the width of an item's text is known exactly (a word wider
// than it is broken, AC-1.6). A bulleted marker is a bullet or a dash (AC-5.9), a numbered one "n.".
#let render-list(b, avail, block-style) = context {
  let ordered = b.at("ordered", default: false)
  let marker-for(i) = if ordered { str(i + 1) + "." } else if look.bullet == "dash" { [–] } else { [•] }
  let gap = 0.5em.to-absolute()
  let marker-width = calc.max(..range(b.items.len()).map(i => measure(text(marker-for(i))).width), 1em.to-absolute())
  let item-width = avail - marker-width - gap
  let a = align-of(block-style)
  grid(
    columns: (marker-width, 1fr),
    column-gutter: gap,
    row-gutter: 0.45em,
    align: (x, y) => if x == 0 { if ordered { right } else { center } } else { a },
    ..b.items.enumerate().map(((i, item)) => (
      text(marker-for(i)),
      if is-empty(item.runs) { par(box(height: 1em)) } else { par(runs-content(item.runs, item-width, block-style)) },
    )).flatten(),
  )
}

#let render-cell-block(c, avail, block-style) = {
  if c.type == "paragraph" { render-paragraph(c, avail, block-style) } else { render-list(c, avail, block-style) }
}

// A row is kept whole on a page unless it is taller than the room a page has for it, and then it may split,
// without losing a line (AC-1.6, spike F1). The header row is repeated on every page the table continues on.
#let render-table(b, block-style) = context {
  let tl = look.table
  let inset = 5pt
  let table-width = body-width - 0.5pt // the borders are drawn half outside the cells: keep them inside
  let total = b.columns.sum()
  // A column is at least as wide as one wide glyph with its padding, so that no word can be left without room.
  let minw = 2 * inset + 1.3 * look.body.size * 1pt
  let raw = b.columns.map(w => calc.max(table-width * (w / total), minw))
  let sum = raw.sum()
  let widths = if sum > table-width { raw.map(w => w * (table-width / sum)) } else { raw }
  let header = b.at("header", default: none)
  let aligns = b.at("align", default: ())
  let cell-content(cell, i, is-header) = {
    set text(weight: "bold") if is-header
    cell.map(x => render-cell-block(x, widths.at(i) - 2 * inset, block-style)).join()
  }
  let row-height(row, is-header) = {
    calc.max(..row.enumerate().map(((i, cell)) => measure(block(width: widths.at(i) - 2 * inset, cell-content(cell, i, is-header))).height)) + 2 * inset
  }
  // Measuring a row costs as much as laying it out, and almost every row is nowhere near a page tall. So a
  // row is measured only when an upper bound of its height does not already show that it fits.
  //
  // The bound: a line holds `m` characters whatever they are (no glyph of the bundled fonts is wider than
  // `widest-glyph` em), and when a line is full the next word did not fit it, so any two lines that follow each
  // other hold at least `m` characters between them. A text of n characters (bytes, which are never fewer)
  // and h hard breaks is at most 2n/m + 1 + h lines; a line is at most `pitch` high.
  let size = if block-style == "title" or repr((header, b.rows)).contains("title") { largest-text } else { look.body.size * 1pt }
  let pitch = 1.2 * look.body.lineSpacing * size
  let text-height(runs, width) = {
    let m = calc.floor(width / (widest-glyph * size))
    if m < 1 { 1000000pt } else {
      let chars = runs.map(r => r.text.len()).sum(default: 0)
      let breaks = runs.map(r => r.text.split("\n").len() - 1).sum(default: 0)
      (2 * calc.ceil(chars / m) + 1 + breaks) * pitch + size
    }
  }
  let cell-bound(cell, width) = cell.map(x => {
    if x.type == "paragraph" { text-height(x.runs, width) } else {
      let marker = (str(x.items.len()).len() + 1) * widest-glyph * size + 0.5 * size
      x.items.map(item => text-height(item.runs, width - marker) + 0.5 * size).sum(default: 0pt) + size
    }
  }).sum(default: 0pt)
  let row-bound(row) = calc.max(..row.enumerate().map(((i, cell)) => cell-bound(cell, widths.at(i) - 2 * inset))) + 2 * inset + 2pt
  // The header row is repeated on every page the table continues on, and is kept whole, only if a page has
  // room for it and for at least a line of a row beside it. A header that leaves no room for that (it is as tall
  // as the page, or taller) is set as the first row of the table instead: it may split between pages like any
  // row taller than a page, without losing a line, and it is not repeated; nothing is ever drawn outside the
  // margins (AC-1.6, AC-5.1).
  let room = 2 * inset + 1.2 * look.body.lineSpacing * largest-text
  let whole-head-bound = if header != none { row-bound(header) } else { 0pt }
  let whole-head-height() = if header != none { row-height(header, true) } else { 0pt }
  let repeats = header != none and (whole-head-bound + room <= body-height or whole-head-height() + room <= body-height)
  let head-bound = if repeats { whole-head-bound } else { 0pt }
  let head-height() = if repeats { whole-head-height() } else { 0pt }
  let fits(row) = row-bound(row) + head-bound <= body-height or row-height(row, false) <= body-height - head-height()
  // A header that is repeated is a header of the table. One that is not is an ordinary first row: a header
  // row of a table is never split between pages, whatever its `breakable` says.
  let head = if repeats {
    (table.header(repeat: true, ..header.enumerate().map(((i, cell)) => table.cell(breakable: false, cell-content(cell, i, true)))),)
  } else if header != none {
    header.enumerate().map(((i, cell)) => table.cell(breakable: true, cell-content(cell, i, true)))
  } else { () }
  let rows = b.rows.map(row => {
    let breakable = not fits(row)
    row.enumerate().map(((i, cell)) => table.cell(breakable: breakable, cell-content(cell, i, false)))
  }).flatten()
  pad(rest: 0.25pt, table(
    columns: widths,
    inset: inset,
    stroke: if tl.borders { 0.5pt + hex(tl.borderColor) } else { none },
    fill: (x, y) => if header != none and y == 0 { hex(tl.headerFill) },
    align: (x, y) => align-of(aligns.at(x, default: "left")),
    ..head,
    ..rows,
  ))
}

// An image is as wide as its share of the body and is scaled down to fit the body's height, keeping its
// proportions, so that nothing is ever drawn outside the margins (AC-1.6, AC-5.1).
#let render-image(b, block-style) = context {
  let w = body-width * b.ratio
  let room = body-height - 1pt
  let drawn = if measure(image(b.path, width: w)).height > room { image(b.path, height: room) } else { image(b.path, width: w) }
  align(align-of(block-style), drawn)
}

#let render(b) = {
  let style = b.at("style", default: none)
  if b.type == "heading" {
    let wrap(c) = text-style(style, c)
    let h = heading(level: b.level, safe(b.text, body-width, wrap))
    if style == "right" or style == "center" { align(align-of(style), h) } else { h }
  }
  else if b.type == "paragraph" { align(align-of(style), render-paragraph(b, body-width, style)) }
  else if b.type == "list" { render-list(b, body-width, style) }
  else if b.type == "table" { render-table(b, style) }
  else if b.type == "image" { render-image(b, style) }
  else if b.type == "pageBreak" { pagebreak(weak: true) }
  else { panic("LH_ERR:unknown_block") }
}

#for b in d.blocks { render(b) }
