{
  "permissions": {
    "allow": [
      "Bash(pnpm install:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm tsc:*)",
      "Bash(bun install:*)",
      "Bash(bun run typecheck:*)",
      "Bash(bun run build:*)",
      "Bash(bun run db:generate:*)",
      "Bash(docker compose ps:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "extraKnownMarketplaces": {
    "wellforge": {
      "source": {
        "source": "github",
        "repo": "matteocodogno/wellforge"
      }
    }
  },
  "enabledPlugins": {
    "wellforge@wellforge": true
  }
}
