{
  "name": "@operai/ui",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Operai design system: tokens, theme, React components and the Storybook that showcases them. Consumed as source by every frontend (ADR 20261031-shared-ui-library-consumed-as-source).",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/styles/tokens.css",
    "./rich-text": "./src/richText.ts"
  },
  "scripts": {
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
