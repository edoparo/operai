# activities-api — local environment (specs/028-activities, ADR-0081/0082/0083).
# Copy to .env and fill in. Never commit the filled-in copy.
# Variables marked (T3), (T6) or (T10) are read by later tasks of specs/028; they are
# listed here so this file is complete when those land.

# ─── Database ─────────────────────────────────────────────────────────────────
# Shared local Postgres (compose.yaml, host port 5435), logical database `activities`.
# The test suite uses `activities_test` (src/test-support/env.ts derives it from this URL).
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/activities

# ─── HTTP ─────────────────────────────────────────────────────────────────────
# The browser calls activities-api from the SHELL's origin (the crm and projects remotes
# run inside it), so :5173 is required; add :5179 / :5181 only to run a remote standalone.
ALLOWED_ORIGINS=http://localhost:5173
PORT=8087
NODE_ENV=development

# ─── Maintenance (AC-2.5, ADR-0083) ───────────────────────────────────────────
# true = every route except GET /health answers 503 `maintenance`. Set during the
# CRM -> activities-api copy, switched off once the import report is clean.
ACTIVITIES_MAINTENANCE=false

# ─── Identity (JWKS resource server, ADR-0005/0010) ───────────────────────────
# Same values as crm-api / projects-api.
AUTH_JWKS_URL=http://localhost:3001/auth/jwks
AUTH_ISSUER=http://localhost:3001
AUTH_AUDIENCE=<same as crm-api AUTH_AUDIENCE>
AUTH_BASE_URL=http://localhost:3001

# ─── Hosts: who answers "may this user ..." (T3, ADR-0081) ────────────────────
# The activity-host resolve endpoints, called with the caller's own Authorization header.
CRM_API_URL=http://localhost:8084
PROJECTS_API_URL=http://localhost:8086

# ─── notify-api, as itself (T6, ADR-0044/0049) ────────────────────────────────
# All three or none. auth needs the matching SERVICE_CLIENTS entry, scope EXACTLY
# `notifications.push emails.send` (two of the three notices are emails, which notify-api
# refuses without emails.send, ADR-0056; plan amendment 2026-11-11):
#   "activities-api":{"secret":"<same secret>","scope":"notifications.push emails.send"}
NOTIFY_INTERNAL_URL=http://localhost:8081
SERVICE_CLIENT_ID=activities-api
SERVICE_CLIENT_SECRET=<random, at least 32 characters: openssl rand -hex 32>

# ─── System routes (T10, ADR-0082) ────────────────────────────────────────────
# Audience of the scoped service JWTs crm-api presents on /system/v1/* (scope
# activities.write, sub system:crm-api). Must equal auth's SERVICE_AUDIENCE and differ
# from AUTH_AUDIENCE.
SERVICE_AUDIENCE=<same as auth SERVICE_AUDIENCE>
