generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Data model of specs/20261110-activities (plan.md § Data model, ADR 20261110-activities-service-access-delegated-to-host). One table of
// activities for every host (CRM companies today, projects), keyed by a host reference
// {hostApp, hostType, hostId} that is an opaque id in another service's database (no foreign
// key across services). People are opaque `auth` user ids; names are resolved live.
// Activity ids are text cuids, and the ids imported from crm-api are kept unchanged.
//
// Raw SQL in the initial migration, the ENFORCEMENT and not a duplicate (Prisma cannot
// express CHECKs):
//   activity  activity_host_shape            a crm activity is pre_sales on a company; a projects
//                                            activity is an operational task on a project with no
//                                            contact, deal or meeting
//             activity_task_fields_only_on_tasks   due date, assignee and completion only on a task
//             activity_completion_pair        completedAt and completedByUserId are both or neither
//             activity_meeting_id_only_on_meetings meetingId only on a meeting activity
//             activity_description_only_on_tasks  a description only on a task
//             activity_description_doc        a description is a document (`type: "doc"`)
//             activity_description_size       at most 128 KiB of JSON
//   task_blocker  task_blocker_not_self      a task never blocks itself
//   activity_file  activity_file_size        1 byte to 20 MiB
//                  activity_file_stored_pair  storedAt is set exactly when status is stored
// Same-host blockers and cycles stay application checks (AC-4.3), as in crm-api.

enum ActivityKind {
  pre_sales
  operational
}

enum ActivityType {
  note
  call
  meeting
  email
  task
}

enum HostApp {
  crm
  projects
}

model Activity {
  id                String       @id @default(cuid())
  kind              ActivityKind
  type              ActivityType
  hostApp           HostApp
  /// "company" | "project" (CHECK activity_host_shape)
  hostType          String
  hostId            String
  /// crm only (CHECK). Nulled when the contact is erased (AC-8.4); no foreign key, the
  /// contact lives in crm-api.
  contactId         String?
  /// crm only (CHECK)
  dealId            String?
  /// <= 200 characters (application check)
  subject           String
  /// <= 10000 characters (application check)
  body              String?
  occurredAt        DateTime
  authorUserId      String
  // Task-only fields (type = task), enforced by a CHECK.
  dueDate           DateTime?    @db.Date
  assigneeUserId    String?
  completedAt       DateTime?
  completedByUserId String?
  /// The last system completion applied (estimate notices, AC-1.3): a notice applies only
  /// when its seq is greater, so duplicates and reordering are no-ops.
  completionSeq     Int?
  /// A task's rich description (a TipTap/ProseMirror document, `type: "doc"`); null on every
  /// other type and on a task without one (CHECKs activity_description_*). Its image nodes refer
  /// to this task's own `ActivityFile` rows by id, never to a URL.
  description       Json?
  /// The Meetings meeting this activity mirrors (specs/20261104-meetings US-14, ADR 20261104-meeting-host-contract-resolve-and-notices): at most one
  /// activity per meeting (UNIQUE), and only a `meeting` activity can carry it (CHECK).
  meetingId         String?      @unique
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  /// The tasks this task waits on (specs/20261101-crm US-6), and the tasks waiting on it.
  blockedBy    TaskBlocker[]         @relation("BlockedTask")
  blocks       TaskBlocker[]         @relation("BlockerTask")
  /// The wellD colleagues who took part, besides the author and the assignee (specs/20261101-crm US-8).
  participants ActivityParticipant[]
  /// Images and attachments of a task (its description's images and the list under it).
  files        ActivityFile[]

  @@index([hostApp, hostType, hostId, occurredAt])
  @@index([contactId])
  @@index([dealId])
  @@index([assigneeUserId, completedAt])
  @@map("activity")
}

/// A wellD colleague who took part in an activity: an Operai user id, never a contact.
/// Removing the activity removes the row.
model ActivityParticipant {
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  userId     String
  createdBy  String
  createdAt  DateTime @default(now())

  @@id([activityId, userId])
  @@index([userId])
  @@map("activity_participant")
}

/// "Blocked by" between two tasks of the same host (AC-4.3). Both ends are tasks (checked by
/// activities-api); deleting either task removes the link.
model TaskBlocker {
  blockedId String
  blocked   Activity @relation("BlockedTask", fields: [blockedId], references: [id], onDelete: Cascade)
  blockerId String
  blocker   Activity @relation("BlockerTask", fields: [blockerId], references: [id], onDelete: Cascade)
  createdBy String
  createdAt DateTime @default(now())

  @@id([blockedId, blockerId])
  @@index([blockerId])
  @@map("task_blocker")
}

/// Content-free ordering guard per meeting (specs/20261104-meetings US-14, ADR 20261104-meeting-host-contract-resolve-and-notices): the highest notice
/// `seq` applied. A notice with `seq <= lastSeq` is a no-op, so duplicates, retries and
/// reordering are harmless. Moved here from crm-api's `meeting_host_state` so the guard
/// commits together with the write it protects (ADR 20261110-caller-chosen-ids-replace-cross-service-transactions).
model MeetingMirrorState {
  meetingId String   @id
  lastSeq   Int
  updatedAt DateTime @updatedAt

  @@map("meeting_mirror_state")
}

/// A contact crm-api has erased (AC-8.4, ADR 20261110-caller-chosen-ids-replace-cross-service-transactions): the id and NOTHING else. The erase handler
/// inserts it, under `pg_advisory_xact_lock(hashtextextended('contact:' || id, 0))`, before it
/// nulls the links; every write that sets a `contactId` takes the same lock and refuses a
/// tombstoned id. Without it a write validated before the erasure could commit the link after
/// the sweep, and nothing would ever remove it. Permanent: an id holds no personal data.
model ErasedContact {
  contactId String @id

  @@map("erased_contact")
}

enum ActivityFileKind {
  /// Shown inside the description, where its image node is.
  image
  /// Listed under the description.
  attachment
}

enum ActivityFileStatus {
  /// A presigned POST was minted; the upload may never complete. Never shown.
  pending
  /// The uploader confirmed it and the object exists in the bucket.
  stored
}

/// A file of a task, in activities-api's own EU bucket (ADR 20261113-task-description-files-in-activities-api-bucket; ADR 20260716-eu-object-storage-refund-attachments posture): uploaded by
/// the browser through a presigned POST, confirmed by a HEAD, read only through a ~60 s presigned
/// GET minted after the host has confirmed the caller may read the task. The bucket object is
/// always deleted BEFORE the row, so a row never outlives a failed delete and an object never
/// outlives its row except for the moment between the two (ADR 20261104-audio-retention-bucket-lifecycle-verified-at-startup order).
model ActivityFile {
  /// UUID v4, chosen by activities-api; also the last part of the object key.
  id               String             @id
  activityId       String
  activity         Activity           @relation(fields: [activityId], references: [id], onDelete: Restrict)
  kind             ActivityFileKind
  status           ActivityFileStatus @default(pending)
  /// The client's name, cleaned for display (never used in the key).
  fileName         String
  contentType      String
  sizeBytes        Int
  /// `activities/<activityId>/<id>`: fixed server-side.
  objectKey        String             @unique
  uploadedByUserId String
  createdAt        DateTime           @default(now())
  storedAt         DateTime?

  @@index([activityId, status])
  @@map("activity_file")
}
